# Logs
logs
*.log

# Build output
/target
**/*.rs.bk

# macOS
.DS_Store

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# Vendored dependencies. D-59 requires vendoring because Flatpak builds have no network
# and every crate must be a declared source; the vendor directory itself is produced by
# `cargo vendor` and is not committed here.
/vendor

# Generated by the ABI crate and committed under D-60 — but only the header is. Build
# intermediates around it are not.
/target-abi

# Swift and Xcode
.build/
*.xcuserdatad
DerivedData/
