# Logs
logs
*.log

# Build output
/target
**/*.rs.bk

# macOS
.DS_Store

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.sw?

# Vendored dependencies. D-59 requires vendoring because Flatpak builds have no network
# and every crate must be a declared source; the vendor directory itself is produced by
# `cargo vendor` and is not committed here.
/vendor

# Generated by the ABI crate and committed under D-60 — but only the header is. Build
# intermediates around it are not.
/target-abi

# Swift and Xcode. The macOS project is generated from shells/macos/project.yml by
# XcodeGen under D-61 — the spec and the Info.plist are the committed source of truth,
# and the .xcodeproj is build output like any other.
.build/
*.xcuserdatad
DerivedData/
/shells/macos/Sift.xcodeproj/

# Per-contributor mise overrides. mise.toml itself is committed and is the definition of
# every command; this is the local escape hatch and must not be.
mise.local.toml

# The OAuth client this checkout is configured with. Not a secret — a public client
# identifier appears in every authorization URL — but it is per-installation configuration,
# and a committed one would make every checkout share one client, one quota and one consent
# screen. See `mise-tasks/macos`.
shells/macos/oauth-client.txt
