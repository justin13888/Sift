#!/usr/bin/env bash
#MISE description="Build the macOS shell (D-61 — Xcode owns the bundle, Rust is the library it links)."
#USAGE flag "--debug" help="Build the debug configuration instead of release"
#USAGE flag "--release" help="Build the release configuration (the default)"
#USAGE flag "--run" help="Launch the bundle after building"
#USAGE flag "--ad-hoc" help="Sign ad-hoc instead of under the team (for a machine with no identity; CI implies it)"
#USAGE flag "--universal" help="Release only: link one arm64+x86_64 core and build both slices (D-46)"
#USAGE flag "--marketing-version <version>" help="The user-facing version written into the bundle (D-62)"
#USAGE flag "--build-number <number>" help="The bundle's build number (D-62)"
#USAGE flag "--source-revision <revision>" help="The git revision stamped into Info.plist (D-62)"
#
# The last four are what `mise run release-rc` passes. Nothing else needs them, and a build
# without them keeps the literals `project.yml` carries.
#
# D-61: **the platform's own application toolchain owns the bundle**, and the Rust core is
# built into a static library it links. The Rust workspace never produces the `.app`, so this
# is two toolchains in sequence rather than one command — and that is a stated cost of the
# decision rather than an accident:
#
#   - the macOS build is not reproducible from `cargo build` alone
#   - a contributor needs the platform toolchain
#   - CI needs a macOS host for even a smoke build
#
# The header step is not optional. The project links `-lsift_abi` against a committed header;
# if the ABI crate has drifted from it, the link would succeed against a stale declaration
# rather than failing.
#
# The project itself is generated from `shells/macos/project.yml`, which is the committed spec.
# That is not D-61's rejected "bespoke script assembling the bundle from parts": nothing here
# assembles a bundle. XcodeGen emits a project and Xcode does the rest, so the Info.plist, the
# URL types and the signing posture stay in the platform's own format, enforced by its own
# machinery.
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

[[ "$(uname -s)" == "Darwin" ]] || {
    echo "macos: this task is macOS-only. The Linux shell is \`mise run linux\`," >&2
    echo "       and \`mise run harness\` drives the application with no window at all." >&2
    exit 1
}

command -v xcodegen >/dev/null 2>&1 || {
    echo "macos: xcodegen is not on PATH. It is pinned in mise.toml under D-61 —" >&2
    echo "       run \`mise install\` and try again." >&2
    exit 1
}

configuration="Release"
launch=false
ad_hoc=false
universal=false
marketing_version=""
build_number=""
source_revision=""
while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    case "$arg" in
        --debug) configuration="Debug" ;;
        --release) configuration="Release" ;;
        --run) launch=true ;;
        --ad-hoc) ad_hoc=true ;;
        --universal) universal=true ;;
        --marketing-version=*) marketing_version="${arg#*=}" ;;
        --build-number=*) build_number="${arg#*=}" ;;
        --source-revision=*) source_revision="${arg#*=}" ;;
        --marketing-version | --build-number | --source-revision)
            [[ $# -gt 0 ]] || { echo "macos: $arg needs a value" >&2; exit 1; }
            case "$arg" in
                --marketing-version) marketing_version="$1" ;;
                --build-number) build_number="$1" ;;
                --source-revision) source_revision="$1" ;;
            esac
            shift
            ;;
        *)
            echo "macos: unknown argument '$arg' (expected --debug, --release, --run, --ad-hoc," >&2
            echo "       --universal, --marketing-version, --build-number or --source-revision)" >&2
            exit 1
            ;;
    esac
done

# D-46's universal artefact is a Release product: the Debug configuration links the host's
# archive and nothing else, and a universal Debug build would be two cargo builds for a bundle
# nobody ships.
if [[ "$universal" == true && "$configuration" != "Release" ]]; then
    echo "macos: --universal builds the Release configuration only." >&2
    exit 1
fi
if [[ -n "$build_number" && ! "$build_number" =~ ^[1-9][0-9]*$ ]]; then
    # D-62 and the register: the build number space begins at 1.
    echo "macos: --build-number must be a positive integer, got '$build_number'." >&2
    exit 1
fi

# **D-45's signing posture, and the one machine it cannot apply to.** `project.yml` signs every
# configuration under the team (see the comment there). A CI runner holds no identity and no
# developer account, so it cannot — and a smoke build there has nothing to gain from one. It
# builds ad-hoc: same project, same entitlements, same hardened runtime, with only the identity
# overridden. The readback below still checks the entitlement set, so a bundle that lost one
# fails in CI too; what it cannot check there is the team and the profile.
#
# Stated rather than silent: an ad-hoc bundle claims a restricted entitlement no profile
# authorises, so the platform refuses to launch it. It is a build check, not a product.
if [[ "${CI:-}" == "true" ]]; then
    ad_hoc=true
fi
if [[ "$ad_hoc" == true && "$launch" == true ]]; then
    echo "macos: --ad-hoc and --run do not combine. An ad-hoc bundle claims the Keychain access" >&2
    echo "       group with no profile authorising it, and the platform refuses to launch it." >&2
    exit 1
fi

# Build settings this invocation overrides on the `xcodebuild` command line, on top of
# `project.yml`. Empty for an ordinary build.
overrides=()

if [[ "$universal" == true ]]; then
    # **D-46 — one core with both slices, linked by an explicit path.** Each architecture is a
    # targeted build (`--target` on the command line wins over `CARGO_BUILD_TARGET`, so the
    # guard below has nothing to guard here), and `lipo` joins the two into an archive under a
    # directory no untargeted build writes. The project is then told that archive's absolute
    # path in place of `-lsift_abi`, so the `target/release` search path is never consulted and
    # a stale host-only archive there cannot be what gets linked.
    slices=()
    for triple in aarch64-apple-darwin x86_64-apple-darwin; do
        cargo build --release -p sift-abi --target "$triple"
        slices+=("target/$triple/release/libsift_abi.a")
    done
    mkdir -p target/universal-apple-darwin/release
    archive="$PWD/target/universal-apple-darwin/release/libsift_abi.a"
    rm -f "$archive"
    lipo -create -output "$archive" "${slices[@]}"
    archs="$(lipo -archs "$archive")"
    for arch in arm64 x86_64; do
        if [[ " $archs " != *" $arch "* ]]; then
            echo "macos: $archive has no $arch slice (it has: $archs)." >&2
            exit 1
        fi
    done
    echo "macos: universal core $archive ($archs)"
    overrides+=("ARCHS=arm64 x86_64" "ONLY_ACTIVE_ARCH=NO" "OTHER_LDFLAGS=$archive")
else
    if [[ "$configuration" == "Release" ]]; then
        cargo build --release -p sift-abi
    else
        cargo build -p sift-abi
    fi

    # The project links `target/{debug,release}/libsift_abi.a` by configuration.
    # `CARGO_BUILD_TARGET` moves cargo's output under `target/$TARGET/` without moving the link
    # path, so the archive the linker finds would be whatever an earlier untargeted build
    # happened to leave there — which is the stale-declaration failure the header step below
    # exists to prevent, arriving by the other door. Neither is worth diagnosing twice.
    if [[ -n "${CARGO_BUILD_TARGET:-}" ]]; then
        echo "macos: CARGO_BUILD_TARGET is set ($CARGO_BUILD_TARGET), so cargo wrote libsift_abi.a" >&2
        echo "       under target/$CARGO_BUILD_TARGET/ while this project links target/{debug,release}." >&2
        echo "       Unset it for this task rather than linking whatever is stale there." >&2
        exit 1
    fi

    archive="target/$([[ "$configuration" == "Release" ]] && echo release || echo debug)/libsift_abi.a"
    [[ -f "$archive" ]] || {
        echo "macos: $archive is missing after the cargo build above." >&2
        exit 1
    }
fi

# D-62 — what `mise run release-rc` stamps. Each is read back from the bundle below.
[[ -z "$marketing_version" ]] || overrides+=("MARKETING_VERSION=$marketing_version")
[[ -z "$build_number" ]] || overrides+=("CURRENT_PROJECT_VERSION=$build_number")
[[ -z "$source_revision" ]] || overrides+=("SIFT_SOURCE_REVISION=$source_revision")

# D-60 — the committed header matches the ABI crate. `mise run bless-header` regenerates it.
cargo xtask header

# The OAuth clients — **one per provider kind** — and the callback scheme derived from each.
#
# **Configuration, not a secret.** A client identifier for a public client appears in every
# authorization URL it generates — that is why PKCE exists — so this is not withheld for
# secrecy. It is out of the repository because it is per-installation: baking one in would make
# every checkout share one client, and a provider's quota, verification status and consent
# screen all attach to the client rather than to the application.
#
# One per kind because a client belongs to one identity platform: an identifier Google issued
# means nothing to Microsoft's. The kinds are the register's opaque strings
# (`crates/providers/sift-registry`), and a kind with no client is absent from the add-account
# choices rather than offered and broken.
#
#   kind   file                                   environment
#   gmail  shells/macos/oauth-client.gmail.txt    SIFT_OAUTH_CLIENT_ID_GMAIL
#          shells/macos/oauth-client.txt          SIFT_OAUTH_CLIENT_ID      (before there were two)
#   graph  shells/macos/oauth-client.graph.txt    SIFT_OAUTH_CLIENT_ID_GRAPH
#
# The scheme is **derived** rather than configured separately, so the two cannot disagree.
# Google's iOS/macOS client type accepts exactly one redirect scheme — the client identifier
# reversed — and its Desktop type wants a 127.0.0.1 loopback, which NFR-24 forbids outright.
# Microsoft's mobile-and-desktop client names its own redirect, so it returns on Sift's scheme,
# which the bundle always registers.
read_client() {
    local variable="$1"
    shift
    local value="${!variable:-}"
    local file
    for file in "$@"; do
        if [[ -z "$value" && -f "$file" ]]; then
            value="$(tr -d '[:space:]' < "$file")"
        fi
    done
    printf '%s' "$value"
}
SIFT_OAUTH_CLIENT_ID_GMAIL="$(read_client SIFT_OAUTH_CLIENT_ID_GMAIL shells/macos/oauth-client.gmail.txt)"
if [[ -z "$SIFT_OAUTH_CLIENT_ID_GMAIL" ]]; then
    SIFT_OAUTH_CLIENT_ID_GMAIL="$(read_client SIFT_OAUTH_CLIENT_ID shells/macos/oauth-client.txt)"
fi
SIFT_OAUTH_CLIENT_ID_GRAPH="$(read_client SIFT_OAUTH_CLIENT_ID_GRAPH shells/macos/oauth-client.graph.txt)"
export SIFT_OAUTH_CLIENT_ID_GMAIL SIFT_OAUTH_CLIENT_ID_GRAPH

# The scheme the Google client requires. It is the one URL type whose scheme varies, so it is
# the one this task has to write; Sift's own is registered unconditionally by `Info.plist`.
export SIFT_OAUTH_SCHEME="net.justinchung.sift"
if [[ -n "$SIFT_OAUTH_CLIENT_ID_GMAIL" ]]; then
    case "$SIFT_OAUTH_CLIENT_ID_GMAIL" in
        *.apps.googleusercontent.com)
            SIFT_OAUTH_SCHEME="com.googleusercontent.apps.${SIFT_OAUTH_CLIENT_ID_GMAIL%.apps.googleusercontent.com}"
            ;;
        *)
            echo "macos: the gmail client does not look like a Google client identifier" >&2
            echo "       (…apps.googleusercontent.com). The only Google client type that can" >&2
            echo "       sign in without a loopback is the iOS type, and its identifiers end" >&2
            echo "       that way — this build will not complete a Google sign-in." >&2
            exit 1
            ;;
    esac
    echo "macos: OAuth client gmail  $SIFT_OAUTH_CLIENT_ID_GMAIL"
    echo "       callback scheme     $SIFT_OAUTH_SCHEME"
fi
if [[ -n "$SIFT_OAUTH_CLIENT_ID_GRAPH" ]]; then
    # An application (client) identifier on the identity platform is a GUID. Anything else is a
    # value pasted into the wrong file, and would fail at the consent screen.
    if [[ ! "$SIFT_OAUTH_CLIENT_ID_GRAPH" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
        echo "macos: the graph client is not an application (client) ID — expected a GUID," >&2
        echo "       got '$SIFT_OAUTH_CLIENT_ID_GRAPH'." >&2
        exit 1
    fi
    echo "macos: OAuth client graph  $SIFT_OAUTH_CLIENT_ID_GRAPH"
    echo "       callback scheme     net.justinchung.sift"
fi
if [[ -z "$SIFT_OAUTH_CLIENT_ID_GMAIL$SIFT_OAUTH_CLIENT_ID_GRAPH" ]]; then
    echo "macos: no OAuth client configured — this build runs against fixtures only."
    echo "       Put one in shells/macos/oauth-client.<kind>.txt, or set"
    echo "       SIFT_OAUTH_CLIENT_ID_<KIND>, to sign in to a real account."
fi

# **Written to a file rather than left in the environment.** These two reached the bundle by
# leaking out of this shell: `project.yml` set them to `${VAR:-default}`, XcodeGen passed the
# token through verbatim — it implements no such operator — and the build only worked because
# `xcodebuild` inherits the environment and Xcode's recursion guard fell through to it. Which
# meant the values landed for a build run from here and for no other: a bare `xcodebuild`, an
# Xcode window, or a second configuration built at a moment this task was not exporting them
# produced a bundle with no client and no derived scheme — silently, because an Info.plist key
# whose expansion is empty is removed rather than emptied. That is what a Debug bundle carrying
# one URL type and no `SiftOAuthClientID` was, and what sent an authorization to a browser it
# could not come back from.
#
# An xcconfig is the platform's own format for exactly this, it is what `project.yml` now reads,
# and it is written on every build — including the no-client build — so there is always one
# file that says what a bundle was configured with.
xcconfig="shells/macos/OAuthClient.xcconfig"
cat >"$xcconfig" <<XCCONFIG
// Generated by \`mise run macos\`. Not committed, and not a secret: a public client's
// identifier appears in every authorization URL it generates, which is why PKCE exists.
// It is per-installation configuration — see \`mise-tasks/macos\`.
SIFT_OAUTH_CLIENT_ID_GMAIL = $SIFT_OAUTH_CLIENT_ID_GMAIL
SIFT_OAUTH_CLIENT_ID_GRAPH = $SIFT_OAUTH_CLIENT_ID_GRAPH
SIFT_OAUTH_SCHEME = $SIFT_OAUTH_SCHEME
XCCONFIG

xcodegen generate --spec shells/macos/project.yml --project shells/macos --quiet

# Every build setting lives in project.yml rather than on this command line, for the same
# reason this task exists at all: a flag written twice is a flag that disagrees with itself.
#
# **`env -u` is doing real work.** `xcodebuild` treats an exported variable as a build-setting
# override, so a build run from this shell would pick up the `SIFT_OAUTH_*` settings whether or
# not the project wires them — which is exactly how the previous arrangement appeared to work
# while wiring nothing, and it would make the check below compare this shell against itself.
# Unsetting them for the build leaves the xcconfig as the only route, so the check afterwards is
# a statement about the project rather than about this environment.
xcode() {
    env -u SIFT_OAUTH_CLIENT_ID -u SIFT_OAUTH_CLIENT_ID_GMAIL -u SIFT_OAUTH_CLIENT_ID_GRAPH \
        -u SIFT_OAUTH_SCHEME \
    xcodebuild \
        -project shells/macos/Sift.xcodeproj \
        -scheme Sift \
        -configuration "$configuration" \
        -derivedDataPath shells/macos/.build/xcode \
        ${overrides[@]+"${overrides[@]}"} \
        "$@"
}

# The team the register records, and the access group it prefixes. `project.yml` and
# `Sift.entitlements` carry the same strings; this is how the readback addresses them.
team="854G577S2Y"

# Three ways to sign, one per situation — D-45, and `project.yml`'s comment on the split.
#
# **Provisioning updates are allowed**, because the Keychain access group is a restricted
# entitlement: without a profile authorising it the platform kills the process at launch. The
# developer account signed in to Xcode supplies it — the development profile for Debug, the
# Developer ID profile at export for Release. Registering this Mac is part of the first: a
# development profile names the machines it may run on.
if [[ "$ad_hoc" == true ]]; then
    echo "macos: signing ad-hoc — a build check with no team and no profile, which the"
    echo "       platform will not launch. Drop --ad-hoc (or CI) to sign under $team."
    # The identity and nothing else. The entitlements and the hardened runtime are the ones a
    # signed build has, so what this checks is the product rather than a relaxed copy of it.
    #
    # **Xcode will not sign this one**, and says why: the access group needs a profile, and it
    # refuses to sign a restricted entitlement without one, ad-hoc or not. So Xcode builds it
    # unsigned and `codesign` applies the committed entitlements file and the runtime flag —
    # the same two inputs `project.yml` gives Xcode, which is what makes the readback below
    # meaningful here too.
    #
    # **The Release export is cleared too**, though this path never writes it. The probes run
    # `.build/export/Sift.app`, and an ad-hoc build that left an earlier team-signed export in
    # place would have them exercise that stale bundle as though it were this one. With it gone
    # they find nothing, and refuse by name.
    rm -rf shells/macos/.build/Sift.xcarchive shells/macos/.build/export
    xcode CODE_SIGNING_ALLOWED=NO build
    app="shells/macos/.build/xcode/Build/Products/$configuration/Sift.app"
    codesign --force --sign - --options runtime \
        --entitlements shells/macos/Sift.entitlements "$app"
elif [[ "$configuration" == "Debug" ]]; then
    xcode -allowProvisioningUpdates -allowProvisioningDeviceRegistration build
    app="shells/macos/.build/xcode/Build/Products/$configuration/Sift.app"
else
    # An archive, then an export for Developer ID: the export is what re-signs with the
    # Developer ID Application identity, embeds the Developer ID profile, and timestamps.
    # Both are removed first, so a failed step cannot leave the previous run's bundle where the
    # readback would find it.
    archive="shells/macos/.build/Sift.xcarchive"
    export_dir="shells/macos/.build/export"
    rm -rf "$archive" "$export_dir"
    # The archive is signed for development first, so it needs the same profile — and the
    # same registration of this Mac — that a Debug build does.
    xcode -allowProvisioningUpdates -allowProvisioningDeviceRegistration \
        -archivePath "$archive" archive
    xcodebuild -exportArchive \
        -archivePath "$archive" \
        -exportPath "$export_dir" \
        -exportOptionsPlist shells/macos/ExportOptions.plist \
        -allowProvisioningUpdates
    app="$export_dir/Sift.app"
fi
# The identifier register in `docs/product/platform-baseline.md`, consumed once for the life
# of the project. `project.yml` sets the same string; this is how the task addresses it.
bundle_id="net.justinchung.sift"
echo "macos: built $app"

# **The bundle is read back, not assumed.** Until now this task printed the client and the
# scheme it intended and never looked at what it made, so a build that dropped both said
# nothing and failed later, in a browser, after the user had granted consent. D-36 requires
# that a registration which did not install be caught before a flow starts; this is the
# earliest place it can be caught at all.
plist="$app/Contents/Info.plist"
for kind in gmail graph; do
    case "$kind" in
        gmail) configured="$SIFT_OAUTH_CLIENT_ID_GMAIL" ;;
        graph) configured="$SIFT_OAUTH_CLIENT_ID_GRAPH" ;;
    esac
    built_client="$(plutil -extract "SiftOAuthClients.$kind" raw -o - "$plist" 2>/dev/null || true)"
    if [[ "$built_client" != "$configured" ]]; then
        echo "macos: the bundle was configured with a $kind client this build did not put in it." >&2
        echo "       configured: ${configured:-<none>}" >&2
        echo "       in bundle:  ${built_client:-<absent>}" >&2
        echo "       An Info.plist key whose expansion is empty is removed rather than emptied," >&2
        echo "       so <absent> means the build setting did not resolve. Check $xcconfig." >&2
        exit 1
    fi
done

# Every scheme the bundle claims, one per line. The derived one has to be among them, and on a
# build with no client that *is* Sift's own — which is why this compares against the resolved
# scheme rather than requiring two entries.
# `plutil` alone, walked by index. Piping the JSON through an interpreter would make a build
# gate depend on a tool nothing declares, and its absence would fail this check with the wrong
# reason — a correct bundle rejected for a cause that is not true, which is the class of error
# this whole task now exists to stop.
built_schemes=""
for i in 0 1 2 3 4 5 6 7; do
    entry="$(plutil -extract "CFBundleURLTypes.$i.CFBundleURLSchemes" raw -o - "$plist" 2>/dev/null || true)"
    [[ -n "$entry" ]] || continue
    for j in 0 1 2 3; do
        scheme="$(plutil -extract "CFBundleURLTypes.$i.CFBundleURLSchemes.$j" raw -o - "$plist" 2>/dev/null || true)"
        [[ -n "$scheme" ]] || continue
        built_schemes+="$scheme"$'\n'
    done
done
# Sift's own scheme is required whatever is configured — the graph client returns on it, and
# D-109 registers it regardless — and the derived one is required where a gmail client is.
for required in "$SIFT_OAUTH_SCHEME" net.justinchung.sift; do
    if ! grep -qxF "$required" <<<"$built_schemes"; then
        echo "macos: the bundle does not register a callback scheme this build requires." >&2
        echo "       expected: $required" >&2
        echo "       claims:   $(tr '\n' ' ' <<<"$built_schemes")" >&2
        echo "       An authorization would be sent to a browser it could not return from." >&2
        exit 1
    fi
done
echo "       registers  $(sort -u <<<"$built_schemes" | tr '\n' ' ')"

# D-62's stamps, read back for the reason the clients are: an override that did not resolve
# leaves the literal in `project.yml`, or removes the key, and says nothing.
for pair in "CFBundleShortVersionString=$marketing_version" "CFBundleVersion=$build_number" \
    "SiftSourceRevision=$source_revision"; do
    key="${pair%%=*}"
    wanted="${pair#*=}"
    [[ -n "$wanted" ]] || continue
    built="$(plutil -extract "$key" raw -o - "$plist" 2>/dev/null || true)"
    if [[ "$built" != "$wanted" ]]; then
        echo "macos: the bundle's $key is '${built:-<absent>}', not the '$wanted' this build set." >&2
        exit 1
    fi
done
if [[ -n "$marketing_version$build_number$source_revision" ]]; then
    echo "       version    $(plutil -extract CFBundleShortVersionString raw -o - "$plist")" \
        "($(plutil -extract CFBundleVersion raw -o - "$plist"))" \
        "$(plutil -extract SiftSourceRevision raw -o - "$plist" 2>/dev/null || echo 'no revision')"
fi

# D-46 — both slices in the executable, not only in the archive it linked.
if [[ "$universal" == true ]]; then
    executable="$app/Contents/MacOS/$(plutil -extract CFBundleExecutable raw -o - "$plist")"
    built_archs="$(lipo -archs "$executable")"
    for arch in arm64 x86_64; do
        if [[ " $built_archs " != *" $arch "* ]]; then
            echo "macos: $executable has no $arch slice (it has: $built_archs)." >&2
            exit 1
        fi
    done
    echo "       architectures $built_archs"
fi

# **The signature is read back too**, for the reason the URL types are: a bundle that lost an
# entitlement should fail here rather than in a user's Keychain. D-45.
codesign --verify --strict --deep "$app" || {
    echo "macos: the bundle's signature does not verify strictly." >&2
    exit 1
}

# The entitlements it carries are **exactly** the declared set, plus what the signing step
# adds by construction and nothing else:
#
#   - the application identifier and team identifier, which a provisioning profile stamps on
#     every bundle it authorises — absent on an ad-hoc build, which has no profile;
#   - `get-task-allow` on Debug only, so a debugger can attach to a development build. A
#     Release bundle carrying it is a bundle any process of the user's may attach to.
#
# Compared as canonical property lists, so ordering and comments in `Sift.entitlements` do not
# matter and a key's value does.
expected="shells/macos/.build/entitlements.expected.plist"
actual="shells/macos/.build/entitlements.actual.plist"
cp shells/macos/Sift.entitlements "$expected"
if [[ "$ad_hoc" != true ]]; then
    plutil -insert 'com\.apple\.application-identifier' -string "$team.$bundle_id" "$expected"
    plutil -insert 'com\.apple\.developer\.team-identifier' -string "$team" "$expected"
    if [[ "$configuration" == "Debug" ]]; then
        plutil -insert 'com\.apple\.security\.get-task-allow' -bool YES "$expected"
    fi
fi
codesign -d --entitlements - --xml "$app" >"$actual" 2>/dev/null
if ! diff -u <(plutil -convert xml1 -o - "$expected") <(plutil -convert xml1 -o - "$actual") >&2; then
    echo "macos: the bundle's entitlements are not the declared set (- declared, + in bundle)." >&2
    echo "       shells/macos/Sift.entitlements is the source of truth; D-45 and" >&2
    echo "       docs/product/platform-baseline.md say what it must hold." >&2
    exit 1
fi

# The hardened runtime, on every build. Notarization refuses a binary without it, and the
# threat model's in-address-space exclusion rests on it.
signature="$(codesign -d --verbose=4 "$app" 2>&1)"
if ! grep -qE '^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime' <<<"$signature"; then
    echo "macos: the bundle is not signed with the hardened runtime." >&2
    exit 1
fi

# Under the team, by the identity the configuration calls for, and — for Release — with a
# secure timestamp, without which a Developer ID signature stops validating when the
# certificate expires.
if [[ "$ad_hoc" != true ]]; then
    case "$configuration" in
        Release) authority="Developer ID Application: .* ($team)" ;;
        Debug) authority="Apple Development: " ;;
    esac
    if ! grep -q "^TeamIdentifier=$team\$" <<<"$signature" \
        || ! grep -q "^Authority=$authority" <<<"$signature"; then
        echo "macos: the bundle is not signed by the identity $configuration requires." >&2
        echo "       expected: $authority, team $team" >&2
        grep -E '^(Authority|TeamIdentifier)=' <<<"$signature" | sed 's/^/       got:      /' >&2
        exit 1
    fi
    if [[ "$configuration" == "Release" ]] && ! grep -q '^Timestamp=' <<<"$signature"; then
        echo "macos: the Release bundle carries no secure timestamp." >&2
        exit 1
    fi
    [[ -f "$app/Contents/embedded.provisionprofile" ]] || {
        echo "macos: the bundle embeds no provisioning profile, so the platform will refuse" >&2
        echo "       the Keychain access group it claims — and the process with it." >&2
        exit 1
    }
fi
if [[ "$ad_hoc" == true ]]; then
    echo "       signed     ad-hoc (not launchable)"
else
    echo "       signed     $(grep -m1 '^Authority=' <<<"$signature" | sed 's/^Authority=//')"
fi
echo "       sandboxed, hardened runtime, entitlements as declared"

if [[ "$launch" == true ]]; then
    # LaunchServices reports canonical paths; `$PWD` is whatever MISE_PROJECT_ROOT said. A
    # checkout reached through a symlink makes those two different strings for one directory.
    bundle="$(cd "$(dirname "$app")" && pwd -P)/$(basename "$app")"

    running_pid() { lsappinfo info -only pid -app "$bundle_id" 2>/dev/null | sed -n 's/^"pid"=\([0-9][0-9]*\).*/\1/p'; }
    running_bundle() { lsappinfo info -only bundlepath -app "$bundle_id" 2>/dev/null | sed -n 's/^"LSBundlePath"="\(.*\)"$/\1/p'; }

    # **Identity here is the bundle identifier, not a path.** D-45 gives every channel one
    # identifier, so at most one Sift can meaningfully be running whatever produced it, and
    # `open` resolves an already-running application by that identifier too. Matching this
    # build's own path instead would miss the other configuration, an installed copy, or this
    # very checkout reached through a symlink — and `open` would then bring *that* one forward
    # while this task reported the build it did not launch.
    if [[ -n "$(running_pid)" ]]; then
        echo "macos: quitting the running $bundle_id first"
        echo "       $(running_bundle)"
        # A quit request and not a signal, so the ordinary termination path runs and D-70's
        # bounded teardown happens. This is a mail client; SIGTERM would skip all of it.
        osascript -e "quit app id \"$bundle_id\"" >/dev/null 2>&1 || true
        for _ in $(seq 1 100); do
            if [[ -z "$(running_pid)" ]]; then break; fi
            sleep 0.1
        done
        if [[ -n "$(running_pid)" ]]; then
            echo "macos: it is still running after ten seconds. Quit it and re-run." >&2
            exit 1
        fi
    fi

    # **LaunchServices is told, not left to notice.** It caches a bundle's URL types against
    # its path, and a configuration that gains a scheme at the same path as one that did not
    # have it is the case where the cache and the bundle disagree. Registering is cheap and
    # removes the disagreement; the shell checks the result at runtime either way.
    lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    if [[ -x "$lsregister" ]]; then
        # Guarded: it is a private tool and exits non-zero in ordinary situations, and under
        # `set -e` that would abort a successful build with no message — the silent failure the
        # branch below congratulates itself for avoiding.
        "$lsregister" -f "$bundle" || {
            echo "macos: lsregister refused to re-register the bundle." >&2
            echo "       Sift checks the registration itself before starting a sign-in." >&2
        }
    else
        echo "macos: lsregister is not where it used to be, so the bundle was not re-registered." >&2
        echo "       Sift checks the registration itself before starting a sign-in, so this is" >&2
        echo "       a slower discovery rather than a silent one." >&2
    fi

    open "$bundle"

    # `open` returns before the process is up, and the failure this task used to have was
    # claiming a launch it never confirmed. Confirm it, and confirm it is *this* bundle.
    pid=""
    for _ in $(seq 1 100); do
        pid="$(running_pid)"
        if [[ -n "$pid" ]]; then break; fi
        sleep 0.1
    done

    if [[ -z "$pid" ]]; then
        echo "macos: nothing answered to $bundle_id within ten seconds." >&2
        echo "       Try \`open '$bundle'\` directly to see what the launch machinery says." >&2
        exit 1
    fi

    launched="$(running_bundle)"
    if [[ "$launched" != "$bundle" ]]; then
        echo "macos: $bundle_id is running from somewhere else — $launched" >&2
        echo "       That is not the build this task just produced." >&2
        exit 1
    fi

    echo "macos: launched $bundle (pid $pid)"
    echo "       A window opens and Sift joins the dock while it is there. The envelope is in"
    echo "       the menu bar too, when the bar has room for it."
    echo "       Closing the window does not quit — that is FR-25, and the menu-bar item is how"
    echo "       you get back or leave deliberately."
fi
