<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- FR-25 and FR-22: Sift is resident with or without a window, so it launches as an
	     accessory rather than a regular application and is reachable through the menu-bar
	     item. The shell raises this to a regular application while a window is open and
	     lowers it again when the last one closes, so the dock reflects what is on screen.
	     This keeps Sift out of the dock on the way there; it does not keep it out once a
	     window opens, which today is immediately. -->
	<key>LSUIElement</key>
	<true/>

	<!-- D-36 — the authorization callback arrives through the registered URI scheme, delivered
	     by the platform's own launch machinery. Not a socket: NFR-24 admits none, for any
	     purpose. The scheme is derived from the bundle identifier because that is what the
	     providers requiring a custom scheme expect. -->
	<!-- D-36's registered URI scheme. Two entries, and the second is not redundant.

	     The first is Sift's own, and is what a provider that lets an application choose its
	     redirect returns through. Google does not: its Desktop client type wants a 127.0.0.1
	     loopback redirect, which NFR-24 forbids outright, and its iOS/macOS type — the only
	     one compatible with that constraint — accepts exactly one scheme, the client
	     identifier reversed. So the second is derived from the configured client at build
	     time, and defaults to Sift's own when no client is configured.

	     Neither is `sift-resource`. That one is registered with the web engine and nowhere
	     else: registering it here would let any local process hand a capability-token address
	     to Sift, which is the one thing D-28's unguessability exists to prevent. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>net.justinchung.sift</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>net.justinchung.sift</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>net.justinchung.sift.oauth</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(SIFT_OAUTH_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- The OAuth client this build was configured with. **Not a secret**: a client identifier
	     for a public client is published in every authorization URL it generates, which is why
	     PKCE exists. It is here rather than baked into the core because it is per-installation
	     configuration, and because a build with none should still run against fixtures. -->
	<key>SiftOAuthClientID</key>
	<string>$(SIFT_OAUTH_CLIENT_ID)</string>
</dict>
</plist>
