{
    "name": "Sift Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tauri-apps.tauri-vscode",
                "vadimcn.vscode-lldb",
                "usernamehw.errorlens",
                "biomejs.biome"
            ]
        }
    },
    "postCreateCommand": "bun install",
    "remoteUser": "vscode"
}
